{
  "$description": "TrackSmart 02 Inventory — colour + typography tokens. Import with Tokens Studio for Figma, or Figma ▸ Local variables ▸ Import (DTCG JSON).",
  "color": {
    "light": {
      "primary": {
        "$type": "color",
        "$value": "#155dfc",
        "$description": "Primary buttons (Add Inventory, Save Inventory, Save assignment, Save & send, + Add Vendor, Edit), active tab and rail underline, active filter chip, switch \"on\", sorted header."
      },
      "primary-hover": {
        "$type": "color",
        "$value": "#1447e6",
        "$description": "Hover of primary buttons; text on blue chips and the \"View only\" strip."
      },
      "primary-subtle": {
        "$type": "color",
        "$value": "#eff6ff",
        "$description": "Icon tiles in headers, ticked rows in the pick list, ticked \"Assigned to\" cards, row hover tint, info notes in the Assign dialog."
      },
      "primary-border": {
        "$type": "color",
        "$value": "#bedbff",
        "$description": "Border of ticked cards, info notes and blue chips."
      },
      "secondary": {
        "$type": "color",
        "$value": "#f1f5f9",
        "$description": "Count pills, KPI chip strip, segmented controls, icon tiles for empty holders."
      },
      "secondary-foreground": {
        "$type": "color",
        "$value": "#314158",
        "$description": "Text on secondary surfaces; outline-button text (Categories, Columns, Cancel)."
      },
      "background": {
        "$type": "color",
        "$value": "#f8fafc",
        "$description": "Page body, table header band, zebra rows, tinted card headers."
      },
      "surface": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Cards, list cards, dialogs, header bands, inputs, the collection card body."
      },
      "text-primary": {
        "$type": "color",
        "$value": "#0f172b",
        "$description": "Page, record and dialog titles; item names; primary cell values."
      },
      "text-body": {
        "$type": "color",
        "$value": "#314158",
        "$description": "Body copy, table cells, form values, draft messages."
      },
      "text-secondary": {
        "$type": "color",
        "$value": "#62748e",
        "$description": "Descriptions, field labels, table headers, vendor lines under item names, helper text."
      },
      "text-muted": {
        "$type": "color",
        "$value": "#90a1b9",
        "$description": "\"no expiry\", empty \"—\", idle icons, placeholders, some 10 px labels. Fails body-text contrast — see §WCAG."
      },
      "border": {
        "$type": "color",
        "$value": "#e2e8f0",
        "$description": "Card, table, dialog and input borders; row dividers (slate-100 inside tables)."
      },
      "border-strong": {
        "$type": "color",
        "$value": "#cad5e2",
        "$description": "Form input borders on Add Vendor and the item form; unticked checkboxes."
      },
      "success": {
        "$type": "color",
        "$value": "#009966",
        "$description": "Active status dot, \"alert set\" bell, check marks, \"Monitoring is on\"."
      },
      "success-text": {
        "$type": "color",
        "$value": "#007a55",
        "$description": "Text of Active pills, Driver chips, \"Collected from the office\"."
      },
      "success-subtle": {
        "$type": "color",
        "$value": "#ecfdf5",
        "$description": "Background of Active pills, Driver chips, settled collection cards."
      },
      "warning": {
        "$type": "color",
        "$value": "#e17100",
        "$description": "Expiring Soon dot, \"in 12d\" countdowns, hand-back card icon."
      },
      "warning-text": {
        "$type": "color",
        "$value": "#bb4d00",
        "$description": "Text of Expiring Soon pills, \"1 expiring\" header note, the no-expiry warning."
      },
      "warning-subtle": {
        "$type": "color",
        "$value": "#fffbeb",
        "$description": "Background of Expiring Soon pills, collection cards in Messages, amber notes."
      },
      "error": {
        "$type": "color",
        "$value": "#e7000b",
        "$description": "Expired dot, \"n days overdue\", Delete category / Delete vendor buttons."
      },
      "error-text": {
        "$type": "color",
        "$value": "#c10007",
        "$description": "Text of Expired pills and the \"n expired\" attention pill; inline errors in the Categories modal."
      },
      "error-subtle": {
        "$type": "color",
        "$value": "#fef2f2",
        "$description": "Background of Expired pills and error boxes."
      },
      "danger": {
        "$type": "color",
        "$value": "#ec003f",
        "$description": "Items marked to come off on the Manage page, Delete items in ⋮ menus, Terminated status."
      },
      "danger-subtle": {
        "$type": "color",
        "$value": "#fff1f2",
        "$description": "Background of rows coming off and of the delete confirmation icon tile."
      },
      "accent": {
        "$type": "color",
        "$value": "#7f22fe",
