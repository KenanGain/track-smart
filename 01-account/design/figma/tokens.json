{
  "$description": "TrackSmart 01 Account — colour + typography tokens. Import with Tokens Studio for Figma, or Figma ▸ Local variables ▸ Import (DTCG JSON).",
  "color": {
    "light": {
      "primary": {
        "$type": "color",
        "$value": "#155dfc",
        "$description": "Primary buttons (Add Asset, Add Driver, Edit Vehicle, Save), active tab text and underline, links, selected KPI ring, toggle \"on\"."
      },
      "primary-hover": {
        "$type": "color",
        "$value": "#1447e6",
        "$description": "Hover state of primary buttons; text on primary-subtle chips."
      },
      "primary-subtle": {
        "$type": "color",
        "$value": "#eff6ff",
        "$description": "Icon tiles in card and page headers, active tab count badge, filter chips, info strip background."
      },
      "primary-border": {
        "$type": "color",
        "$value": "#bedbff",
        "$description": "Border of filter chips, info strip, \"Required\" pill."
      },
      "secondary": {
        "$type": "color",
        "$value": "#f1f5f9",
        "$description": "Secondary surfaces: count badges, avatar circles, segmented control track, hover of icon buttons."
      },
      "secondary-foreground": {
        "$type": "color",
        "$value": "#314158",
        "$description": "Text on secondary surfaces; outline-button text."
      },
      "background": {
        "$type": "color",
        "$value": "#f8fafc",
        "$description": "Page body behind the cards; table header band; tinted card headers."
      },
      "surface": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Cards, modals, page header band, top bar, sidebar, tables, inputs."
      },
      "text-primary": {
        "$type": "color",
        "$value": "#0f172b",
        "$description": "Page and card titles, primary cell values, modal titles."
      },
      "text-body": {
        "$type": "color",
        "$value": "#314158",
        "$description": "Body copy, table cells, form values."
      },
      "text-secondary": {
        "$type": "color",
        "$value": "#62748e",
        "$description": "Subtitles, field labels (11 px uppercase), table header text, helper text."
      },
      "text-muted": {
        "$type": "color",
        "$value": "#90a1b9",
        "$description": "Micro labels on KPI tiles, idle icons, placeholders, \"—\" for empty values. Fails body-text contrast — see §WCAG."
      },
      "border": {
        "$type": "color",
        "$value": "#e2e8f0",
        "$description": "Card, table, modal and input borders; dividers (slate-100 for in-table rules)."
      },
      "border-strong": {
        "$type": "color",
        "$value": "#cad5e2",
        "$description": "Form input borders in modals and page forms; dashed upload zones."
      },
      "success": {
        "$type": "color",
        "$value": "#009966",
        "$description": "Active status dot, check icons, \"On file\" marks."
      },
      "success-text": {
        "$type": "color",
        "$value": "#007a55",
        "$description": "Text of Active / Clean pills."
      },
      "success-subtle": {
        "$type": "color",
        "$value": "#ecfdf5",
        "$description": "Background of Active / Clean pills and success banners."
      },
      "warning": {
        "$type": "color",
        "$value": "#e17100",
        "$description": "Maintenance / On Leave dot, \"expiring soon\" icon."
      },
      "warning-text": {
        "$type": "color",
        "$value": "#bb4d00",
        "$description": "Text of Maintenance / On Leave / Awaiting pills; \"Expiring Soon\"."
      },
      "warning-subtle": {
        "$type": "color",
        "$value": "#fffbeb",
        "$description": "Background of warning pills and missing-document strips."
