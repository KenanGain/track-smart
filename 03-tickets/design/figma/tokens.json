{
  "$description": "TrackSmart 03 Tickets — colour + typography tokens. Import with Tokens Studio for Figma, or Figma ▸ Local variables ▸ Import (DTCG JSON).",
  "color": {
    "light": {
      "primary": {
        "$type": "color",
        "$value": "#155dfc",
        "$description": "Primary buttons (Add Ticket, Edit Ticket, Save Ticket, Sync feeds, Send & close review), active tab underline, citation numbers, switch \"on\"."
      },
      "primary-hover": {
        "$type": "color",
        "$value": "#1447e6",
        "$description": "Hover of primary buttons; text on blue chips (PAPER, In Court) and the \"View only\" strip."
      },
      "primary-subtle": {
        "$type": "color",
        "$value": "#eff6ff",
        "$description": "Icon tiles in headers, the detail ticket tile, PAPER badge, In Court pill, selected charge chips, vehicle info box."
      },
      "primary-border": {
        "$type": "color",
        "$value": "#bedbff",
        "$description": "Border of blue chips, selected charge chips and the vehicle info box."
      },
      "secondary": {
        "$type": "color",
        "$value": "#f1f5f9",
        "$description": "Count pills, Yes / No segmented track, Closed pill, Equipment defect / Parking badges."
      },
      "secondary-foreground": {
        "$type": "color",
        "$value": "#314158",
        "$description": "Text on secondary surfaces; outline-button text (Export, Share to chat, Cancel)."
      },
      "background": {
        "$type": "color",
        "$value": "#f8fafc",
        "$description": "Page body, table header band, row hover, breadcrumb strip."
      },
      "surface": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Cards, KPI cards, dialogs, header bands, inputs."
      },
      "text-primary": {
        "$type": "color",
        "$value": "#0f172b",
        "$description": "Page, ticket and dialog titles; primary values; amounts."
      },
      "text-body": {
        "$type": "color",
        "$value": "#314158",
        "$description": "Body copy, table cells, form values, message templates."
      },
      "text-secondary": {
        "$type": "color",
        "$value": "#62748e",
        "$description": "Descriptions, field labels, table headers, KPI labels, helper text."
      },
      "text-muted": {
        "$type": "color",
        "$value": "#90a1b9",
        "$description": "KPI sub-lines, empty \"—\", idle doc icons, placeholders. Fails body-text contrast — see §WCAG."
      },
      "border": {
        "$type": "color",
        "$value": "#e2e8f0",
        "$description": "Card, table, dialog and input borders; row dividers."
      },
      "border-strong": {
        "$type": "color",
        "$value": "#cad5e2",
        "$description": "Form input borders; unselected charge chips; checkboxes."
      },
      "success": {
        "$type": "color",
        "$value": "#009966",
        "$description": "Paid status dot, Paid This Month card, doc icons on file, verified check."
      },
      "success-text": {
        "$type": "color",
        "$value": "#007a55",
        "$description": "Text of Paid pills, Closed review status, \"Monitoring on\"."
      },
      "success-subtle": {
        "$type": "color",
        "$value": "#ecfdf5",
        "$description": "Background of Paid pills and the reconciled banner."
      },
      "warning": {
        "$type": "color",
        "$value": "#e17100",
        "$description": "Due status dot, Open Offenses card, missing-references bell."
      },
      "warning-text": {
        "$type": "color",
        "$value": "#bb4d00",
        "$description": "Text of Due pills, In Review status, Serious severity, warning-letter chip."
      },
      "warning-subtle": {
        "$type": "color",
        "$value": "#fffbeb",
        "$description": "Background of Due pills, the missing-references table and the warning-letter banner."
      },
      "error": {
        "$type": "color",
        "$value": "#e7000b",
        "$description": "OOS chip, overdue dates, Speeding / Red Light badges, Terminate driver."
      },
      "error-text": {
        "$type": "color",
        "$value": "#c10007",
        "$description": "Text of OOS chips, Speeding badges and \"Overdue · n days ago\"."
      },
      "error-subtle": {
        "$type": "color",
        "$value": "#fef2f2",
        "$description": "Background of OOS chips and Speeding badges."
      },
      "danger": {
        "$type": "color",
        "$value": "#ec003f",
        "$description": "Outstanding KPI value, Delete ticket in ⋮, Remove ticket button, Critical severity."
      },
      "danger-subtle": {
        "$type": "color",
        "$value": "#fff1f2",
        "$description": "Background of the remove-ticket icon tile and Critical severity chips."
      },
      "accent": {
        "$type": "color",
        "$value": "#7f22fe",
        "$description": "eTicket badge, Electronic KPI card, Assign training resolution."
      },
      "accent-text": {
        "$type": "color",
        "$value": "#7008e7",
        "$description": "Text of the eTicket badge and the Electronic KPI value."
      },
      "accent-subtle": {
        "$type": "color",
        "$value": "#f5f3ff",
        "$description": "Background of the eTicket badge."
      },
      "info": {
        "$type": "color",
        "$value": "#1447e6",
        "$description": "Text of the \"View only\" strip and informational notes (shares the primary hue on purpose)."
      },
      "info-subtle": {
        "$type": "color",
        "$value": "#eff6ff",
        "$description": "Background of the \"View only\" strip and info notes."
      },
      "neutral-inverse": {
        "$type": "color",
        "$value": "#0f172b",
        "$description": "Selected sub-category card border and number."
      }
    },
